# .env.example — copy to .env.local and fill in real values.
# The real .env.local is gitignored: never commit it. Keep secrets out of code.

# --- Supabase (from your project's Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser, never prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
